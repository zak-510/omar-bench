// DSL-arm chain probe, n=20, backend=Codex. Generated by gen.py.
team Relay(idx : int, nn : int)[agent : Codex]
{
    input msg : string
    output fwd : string

    task agent(msg) -> fwd
    "
        You are node $(idx) of $(nn) in a relay chain. Chain protocol:
        append 'node $(idx)' to the trail, keep every existing payload
        field and trail entry intact, and pass the full updated message
        onward by setting `fwd`.
        You received:

        $(msg)
    "
}

main Chain20 {
    r1 = Relay(1, 20)
    r2 = Relay(2, 20)
    r3 = Relay(3, 20)
    r4 = Relay(4, 20)
    r5 = Relay(5, 20)
    r6 = Relay(6, 20)
    r7 = Relay(7, 20)
    r8 = Relay(8, 20)
    r9 = Relay(9, 20)
    r10 = Relay(10, 20)
    r11 = Relay(11, 20)
    r12 = Relay(12, 20)
    r13 = Relay(13, 20)
    r14 = Relay(14, 20)
    r15 = Relay(15, 20)
    r16 = Relay(16, 20)
    r17 = Relay(17, 20)
    r18 = Relay(18, 20)
    r19 = Relay(19, 20)
    r20 = Relay(20, 20)
    r1.fwd -> r2.msg
    r2.fwd -> r3.msg
    r3.fwd -> r4.msg
    r4.fwd -> r5.msg
    r5.fwd -> r6.msg
    r6.fwd -> r7.msg
    r7.fwd -> r8.msg
    r8.fwd -> r9.msg
    r9.fwd -> r10.msg
    r10.fwd -> r11.msg
    r11.fwd -> r12.msg
    r12.fwd -> r13.msg
    r13.fwd -> r14.msg
    r14.fwd -> r15.msg
    r15.fwd -> r16.msg
    r16.fwd -> r17.msg
    r17.fwd -> r18.msg
    r18.fwd -> r19.msg
    r19.fwd -> r20.msg
}
