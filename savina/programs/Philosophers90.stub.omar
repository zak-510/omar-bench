team Philosopher5[agent : Stub]
{
    input grant : string
    output done : string

    // @title Eat one meal
    // @desc Runs only while the arbitrator has given this philosopher both of its forks.
    task agent(grant) -> done """
        You are philosopher 5 of 5 at a round table. You use fork 5 on your left and fork 1 on your right; philosophers 4 and 1 share them with you. You eat 18 meals, one at a time, and you may eat only while you hold both of your forks.

        The arbitrator has given you both of your forks for this meal; they go back when you answer. Do the meal below and set `done` to the answer only.

        $(grant)
    """
}

team Arbitrator
{
    input d1 : string
    input d2 : string
    input d3 : string
    input d4 : string
    input d5 : string
    output g1 : string
    output g2 : string
    output g3 : string
    output g4 : string
    output g5 : string
    output log : string
    timer start(1ms, 0)
    state holder : string = "00000"
    state eaten : string = "00000"
    state trace : string = ""

    // @title Hand out forks
    // @desc Frees a philosopher's forks when it finishes a meal, then gives both forks to every
    // philosopher with meals left whose forks are free, least-fed first. Ends the run after the
    // last meal. The trace records every grant and every finished meal for the checker.
    reaction(start, d1, d2, d3, d4, d5) -> g1?, g2?, g3?, g4?, g5?, log? {=
        let _ = &start;
        const N: usize = 5;
        const MEALS: u8 = 18;
        const Q: [[(u32, u32); 18]; 5] = [[(30, 26), (43, 31), (56, 36), (69, 41), (82, 46), (95, 51), (18, 56), (31, 61), (44, 66), (57, 71), (70, 76), (83, 81), (96, 86), (19, 91), (32, 96), (45, 11), (58, 16), (71, 21)], [(37, 37), (50, 42), (63, 47), (76, 52), (89, 57), (12, 62), (25, 67), (38, 72), (51, 77), (64, 82), (77, 87), (90, 92), (13, 97), (26, 12), (39, 17), (52, 22), (65, 27), (78, 32)], [(44, 48), (57, 53), (70, 58), (83, 63), (96, 68), (19, 73), (32, 78), (45, 83), (58, 88), (71, 93), (84, 98), (97, 13), (20, 18), (33, 23), (46, 28), (59, 33), (72, 38), (85, 43)], [(51, 59), (64, 64), (77, 69), (90, 74), (13, 79), (26, 84), (39, 89), (52, 94), (65, 99), (78, 14), (91, 19), (14, 24), (27, 29), (40, 34), (53, 39), (66, 44), (79, 49), (92, 54)], [(58, 70), (71, 75), (84, 80), (97, 85), (20, 90), (33, 95), (46, 10), (59, 15), (72, 20), (85, 25), (98, 30), (21, 35), (34, 40), (47, 45), (60, 50), (73, 55), (86, 60), (99, 65)]];
        let dones = [d1, d2, d3, d4, d5];
        let mut holder: Vec<u8> = self.holder.bytes().map(|b| b - b'0').collect();
        let mut eaten: Vec<u8> = self.eaten.bytes().map(|b| b - b'0').collect();
        for i in 0..N {
            if let Some(ans) = &dones[i] {
                let p = (i + 1) as u8;
                for f in [i, (i + 1) % N] {
                    if holder[f] == p { holder[f] = 0; }
                }
                eaten[i] += 1;
                let clean: String = ans.chars().map(|c| if c == ';' || c == '\n' { ' ' } else { c }).collect();
                self.trace.push_str(&format!("done {} {} {};", p, eaten[i], clean.trim()));
            }
        }
        let mut order: Vec<usize> = (0..N).collect();
        order.sort_by_key(|&i| (eaten[i], i));
        let mut grants: Vec<Option<String>> = vec![None; N];
        for &i in &order {
            let p = (i + 1) as u8;
            let (l, r) = (i, (i + 1) % N);
            if eaten[i] < MEALS && holder[l] == 0 && holder[r] == 0 {
                holder[l] = p;
                holder[r] = p;
                let k = eaten[i] as usize + 1;
                let (a, b) = Q[i][k - 1];
                grants[i] = Some(format!("Meal {}: what is {} + {}? Answer with the number only.", k, a, b));
                self.trace.push_str(&format!("grant {} {};", p, k));
            }
        }
        self.holder = holder.iter().map(|d| (b'0' + d) as char).collect();
        self.eaten = eaten.iter().map(|d| (b'0' + d) as char).collect();
        g1 = grants[0].take(); g2 = grants[1].take(); g3 = grants[2].take(); g4 = grants[3].take(); g5 = grants[4].take();
        if eaten.iter().all(|&e| e == MEALS) {
            log = Some(self.trace.clone());
            request_stop();
        }
    =}
}

main Philosophers {
    a = Arbitrator()
    p1 = Philosopher1()
    p2 = Philosopher2()
    p3 = Philosopher3()
    p4 = Philosopher4()
    p5 = Philosopher5()
    a.g1 -> p1.grant
    p1.done -> a.d1 after 0
    a.g2 -> p2.grant
    p2.done -> a.d2 after 0
    a.g3 -> p3.grant
    p3.done -> a.d3 after 0
    a.g4 -> p4.grant
    p4.done -> a.d4 after 0
    a.g5 -> p5.grant
    p5.done -> a.d5 after 0
}
