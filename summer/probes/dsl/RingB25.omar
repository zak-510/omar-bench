// DSL-arm ring probe (bounded), n=25, laps=2, backend=Claude. Generated by gen.py.
team RingNode(idx : int, nn : int)[agent : Claude]
{
    input m1 : string
    input m2 : string
    output fwd1 : string
    output fwd2 : string

    task agent(m1) -> fwd1
    "
        You are node $(idx) of $(nn) in a message-passing ring. Ring
        protocol: append 'node $(idx)' to the trail, then pass the full
        updated message to your successor by setting `fwd1`.
        You received:

        $(m1)
    "

    task agent(m2) -> fwd2
    "
        You are node $(idx) of $(nn) in a message-passing ring. Ring
        protocol: append 'node $(idx)' to the trail, then pass the full
        updated message to your successor by setting `fwd2`.
        You received:

        $(m2)
    "
}

main RingB25 {
    r1 = RingNode(1, 25)
    r2 = RingNode(2, 25)
    r3 = RingNode(3, 25)
    r4 = RingNode(4, 25)
    r5 = RingNode(5, 25)
    r6 = RingNode(6, 25)
    r7 = RingNode(7, 25)
    r8 = RingNode(8, 25)
    r9 = RingNode(9, 25)
    r10 = RingNode(10, 25)
    r11 = RingNode(11, 25)
    r12 = RingNode(12, 25)
    r13 = RingNode(13, 25)
    r14 = RingNode(14, 25)
    r15 = RingNode(15, 25)
    r16 = RingNode(16, 25)
    r17 = RingNode(17, 25)
    r18 = RingNode(18, 25)
    r19 = RingNode(19, 25)
    r20 = RingNode(20, 25)
    r21 = RingNode(21, 25)
    r22 = RingNode(22, 25)
    r23 = RingNode(23, 25)
    r24 = RingNode(24, 25)
    r25 = RingNode(25, 25)
    r1.fwd1 -> r2.m1
    r2.fwd1 -> r3.m1
    r3.fwd1 -> r4.m1
    r4.fwd1 -> r5.m1
    r5.fwd1 -> r6.m1
    r6.fwd1 -> r7.m1
    r7.fwd1 -> r8.m1
    r8.fwd1 -> r9.m1
    r9.fwd1 -> r10.m1
    r10.fwd1 -> r11.m1
    r11.fwd1 -> r12.m1
    r12.fwd1 -> r13.m1
    r13.fwd1 -> r14.m1
    r14.fwd1 -> r15.m1
    r15.fwd1 -> r16.m1
    r16.fwd1 -> r17.m1
    r17.fwd1 -> r18.m1
    r18.fwd1 -> r19.m1
    r19.fwd1 -> r20.m1
    r20.fwd1 -> r21.m1
    r21.fwd1 -> r22.m1
    r22.fwd1 -> r23.m1
    r23.fwd1 -> r24.m1
    r24.fwd1 -> r25.m1
    r25.fwd1 -> r1.m2
    r1.fwd2 -> r2.m2
    r2.fwd2 -> r3.m2
    r3.fwd2 -> r4.m2
    r4.fwd2 -> r5.m2
    r5.fwd2 -> r6.m2
    r6.fwd2 -> r7.m2
    r7.fwd2 -> r8.m2
    r8.fwd2 -> r9.m2
    r9.fwd2 -> r10.m2
    r10.fwd2 -> r11.m2
    r11.fwd2 -> r12.m2
    r12.fwd2 -> r13.m2
    r13.fwd2 -> r14.m2
    r14.fwd2 -> r15.m2
    r15.fwd2 -> r16.m2
    r16.fwd2 -> r17.m2
    r17.fwd2 -> r18.m2
    r18.fwd2 -> r19.m2
    r19.fwd2 -> r20.m2
    r20.fwd2 -> r21.m2
    r21.fwd2 -> r22.m2
    r22.fwd2 -> r23.m2
    r23.fwd2 -> r24.m2
    r24.fwd2 -> r25.m2
}
