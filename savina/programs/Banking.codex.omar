team Teller
{
    input y1 : string
    input n1 : string
    input y2 : string
    input n2 : string
    input y3 : string
    input n3 : string
    input y4 : string
    input n4 : string
    input y5 : string
    input n5 : string
    output r1 : string
    output r2 : string
    output r3 : string
    output r4 : string
    output r5 : string
    output log : string
    timer start(1ms, 0)
    state bal : string = "1000,1000,1000,1000,1000"
    state k : int = 0
    state trace : string = ""

    // @title Run the transfers
    // @desc Sends each transfer, in order, to the paying account with that account's balance,
    // applies the account's verdict to the ledger, then sends the next. Ends the run after the
    // last one. The trace records every verdict and the final balances for the checker.
    reaction(start, y1, n1, y2, n2, y3, n3, y4, n4, y5, n5) -> r1?, r2?, r3?, r4?, r5?, log? {=
        const S: [(usize, usize, usize, i64); 30] = [(1, 4, 2, 50), (2, 3, 5, 600), (3, 1, 4, 100), (4, 2, 4, 50), (5, 5, 4, 850), (6, 3, 4, 900), (7, 5, 2, 100), (8, 1, 3, 400), (9, 4, 1, 300), (10, 3, 5, 50), (11, 1, 3, 900), (12, 3, 2, 350), (13, 5, 3, 150), (14, 4, 5, 400), (15, 5, 3, 100), (16, 5, 2, 600), (17, 1, 2, 200), (18, 4, 2, 700), (19, 4, 1, 800), (20, 5, 3, 150), (21, 5, 2, 300), (22, 4, 5, 700), (23, 2, 5, 800), (24, 2, 5, 50), (25, 3, 1, 800), (26, 2, 5, 250), (27, 3, 1, 850), (28, 5, 4, 850), (29, 4, 5, 450), (30, 4, 5, 800)];
        let mut bal: Vec<i64> = self.bal.split(',').map(|s| s.parse().unwrap()).collect();
        let verdicts = [(y1.is_some(), n1.is_some()), (y2.is_some(), n2.is_some()), (y3.is_some(), n3.is_some()), (y4.is_some(), n4.is_some()), (y5.is_some(), n5.is_some())];
        let mut advance = start.is_some() && self.k == 0;
        if self.k > 0 {
            let (k, payer, payee, amount) = S[self.k as usize - 1];
            for (j, (y, n)) in verdicts.iter().enumerate() {
                if !*y && !*n { continue; }
                if j + 1 != payer {
                    self.trace.push_str(&format!("T{} stray verdict from account {};", k, j + 1));
                    continue;
                }
                if *y {
                    bal[payer - 1] -= amount;
                    bal[payee - 1] += amount;
                }
                self.trace.push_str(&format!("T{} {};", k, if *y { "approve" } else { "deny" }));
                advance = true;
            }
        }
        if advance && (self.k as usize) < S.len() {
            self.k += 1;
            let (k, payer, payee, amount) = S[self.k as usize - 1];
            let msg = format!("Transfer T{}: pay ${} to account {}. Account {}'s current balance is ${}.",
                              k, amount, payee, payer, bal[payer - 1]);
            match payer {
            1 => r1 = Some(msg),
            2 => r2 = Some(msg),
            3 => r3 = Some(msg),
            4 => r4 = Some(msg),
            5 => r5 = Some(msg),
            _ => {}
            }
        } else if advance {
            let b: Vec<String> = bal.iter().map(|x| x.to_string()).collect();
            log = Some(format!("{}balances {}", self.trace, b.join(",")));
            request_stop();
        }
        let b: Vec<String> = bal.iter().map(|x| x.to_string()).collect();
        self.bal = b.join(",");
    =}
}

main Banking {
    t = Teller()
    a1 = Account1()
    a2 = Account2()
    a3 = Account3()
    a4 = Account4()
    a5 = Account5()
    t.r1 -> a1.request
    a1.yes -> t.y1 after 0
    a1.no -> t.n1 after 0
    t.r2 -> a2.request
    a2.yes -> t.y2 after 0
    a2.no -> t.n2 after 0
    t.r3 -> a3.request
    a3.yes -> t.y3 after 0
    a3.no -> t.n3 after 0
    t.r4 -> a4.request
    a4.yes -> t.y4 after 0
    a4.no -> t.n4 after 0
    t.r5 -> a5.request
    a5.yes -> t.y5 after 0
    a5.no -> t.n5 after 0
}
