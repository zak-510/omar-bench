// DSL-arm ring probe (judged), n=40, laps=2, backend=Claude. Generated by gen.py.
team RingNode(idx : int, nn : int)[agent : Claude]
{
    input m1 : string
    input m2 : string
    output fwd1 : string
    output fwd2 : string
    output done1 : string
    output done2 : string

    task agent(m1) -> (fwd1 | done1)
    "
        You are node $(idx) of $(nn) in a message-passing ring. Ring
        protocol: append 'node $(idx)' to the trail, then pass the full
        updated message to your successor by setting `fwd1`. The task
        inside the message says how long the ring should keep
        circulating; you decide whether to keep passing (set `fwd1`) or
        to finish the whole run (set `done1` to the final message).
        Set exactly one, never both.
        You received:

        $(m1)
    "

    task agent(m2) -> (fwd2 | done2)
    "
        You are node $(idx) of $(nn) in a message-passing ring. Ring
        protocol: append 'node $(idx)' to the trail, then pass the full
        updated message to your successor by setting `fwd2`. The task
        inside the message says how long the ring should keep
        circulating; you decide whether to keep passing (set `fwd2`) or
        to finish the whole run (set `done2` to the final message).
        Set exactly one, never both.
        You received:

        $(m2)
    "
}

main RingJ40 {
    r1 = RingNode(1, 40)
    r2 = RingNode(2, 40)
    r3 = RingNode(3, 40)
