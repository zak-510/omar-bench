// DSL-arm chain probe, n=100, nodes 51..100, backend=Stub. Generated by gen.py.
team Relay(idx : int, nn : int)[agent : Stub]
{
    input msg : string
    output fwd : string

    task agent(msg) -> fwd
    "
        You are node $(idx) of $(nn) in a relay chain. Chain protocol:
        append 'node $(idx)' to the trail, keep every existing payload
        field and trail entry intact, and pass the full updated message
        onward by setting `fwd`.
        You received:

        $(msg)
    "
}

main Chain100seg51to100 {
    r51 = Relay(51, 100)
    r52 = Relay(52, 100)
    r53 = Relay(53, 100)
