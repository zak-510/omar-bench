team Worker(idx : int, nn : int)[agent : Stub]
{
    input q : string
    output report : string

    task agent(q) -> report
    "
        You are worker $(idx) of $(nn) answering a shared task independently. Task:

        $(q)

        Set `report` to your answer and nothing else.
    "
}

team DeadWorker(idx : int, nn : int)[agent : Stub]
{
    input q : string
    output report : string

    task agent(q) -> report? within(1ms)
    "
        You are worker $(idx) of $(nn) answering a shared task independently. Task:

        $(q)

        Set `report` to your answer and nothing else.
    "
}

team Gather[agent : Stub]
{
    input r1 : string
    input r2 : string
    input r3 : string
    input r4 : string
    input r5 : string
    output answer : string

    task agent(r1, r2, r3, r4, r5) -> answer?
    "
        Below are candidate final answers to the question. Decide which is most
        consistent and correct, then output that answer in full as your own.
        Reproduce the complete answer expression itself; never refer to a
        candidate by number or label (do not write 'Candidate 2' or 'Agent 4')
        and do not add a 'consensus' prefix. Either set `answer` to that final
        answer, or complete without setting `answer` if you should not answer.

        Question: What is 12 times 12? Give ONLY the number.
        Candidates:
        [Candidate 1] $(r1)
        [Candidate 2] $(r2)
        [Candidate 3] $(r3)
        [Candidate 4] $(r4)
        [Candidate 5] $(r5)
    "
}

main SGMiss5NoneF1 {
    w1 = DeadWorker(1, 5)
    w2 = Worker(2, 5)
    w3 = Worker(3, 5)
    w4 = Worker(4, 5)
    w5 = Worker(5, 5)
    g = Gather()

    w1.report -> g.r1
    w2.report -> g.r2
    w3.report -> g.r3
    w4.report -> g.r4
    w5.report -> g.r5
}
