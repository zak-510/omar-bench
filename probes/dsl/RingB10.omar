// DSL-arm ring probe (bounded), n=10, laps=2, backend=Claude. Generated by gen.py.
team RingNode(idx : int, nn : int)[agent : Claude]
{
    input m1 : string
    input m2 : string
    output fwd1 : string
    output fwd2 : string

    task agent(m1) -> fwd1
    "
        You are node $(idx) of $(nn) in a message-passing ring. Ring
        protocol: append 'node $(idx)' to the trail, then pass the full
        updated message to your successor by setting `fwd1`.
        You received:

        $(m1)
    "

    task agent(m2) -> fwd2
    "
        You are node $(idx) of $(nn) in a message-passing ring. Ring
        protocol: append 'node $(idx)' to the trail, then pass the full
        updated message to your successor by setting `fwd2`.
        You received:

        $(m2)
    "
}

main RingB10 {
    r1 = RingNode(1, 10)
    r2 = RingNode(2, 10)
    r3 = RingNode(3, 10)
    r4 = RingNode(4, 10)
    r5 = RingNode(5, 10)
    r6 = RingNode(6, 10)
    r7 = RingNode(7, 10)
    r8 = RingNode(8, 10)
    r9 = RingNode(9, 10)
    r10 = RingNode(10, 10)
    r1.fwd1 -> r2.m1
    r2.fwd1 -> r3.m1
    r3.fwd1 -> r4.m1
    r4.fwd1 -> r5.m1
    r5.fwd1 -> r6.m1
    r6.fwd1 -> r7.m1
    r7.fwd1 -> r8.m1
    r8.fwd1 -> r9.m1
    r9.fwd1 -> r10.m1
    r10.fwd1 -> r1.m2
    r1.fwd2 -> r2.m2
    r2.fwd2 -> r3.m2
    r3.fwd2 -> r4.m2
    r4.fwd2 -> r5.m2
    r5.fwd2 -> r6.m2
    r6.fwd2 -> r7.m2
    r7.fwd2 -> r8.m2
    r8.fwd2 -> r9.m2
    r9.fwd2 -> r10.m2
}
