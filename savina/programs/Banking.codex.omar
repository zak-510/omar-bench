// Savina Banking (bank transaction, one transfer at a time), DSL arm, backend=Codex. Generated by savina/build.py.
team Account1[agent : Codex]
{
    input request : string
    output yes : string
    output no : string

    // @title Approve or refuse a transfer
    // @desc Decides one transfer from this account, given its amount and the account's balance.
    task agent(request) -> (yes | no) """
        You are the budget agent for account 1. A transfer from your account may go ahead only if its amount is not more than your current balance.

        The teller is asking about one transfer from your account. The request gives the amount and your account's current balance. Set `yes` to let it go ahead or `no` to refuse it; either way the value is a one-line reason.

        $(request)
    """
}

