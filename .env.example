# Copy to .env on the machine that runs benchmarks. Never commit .env.
# Only names are ever recorded in a run manifest, never values.
# Keep comments on their own lines.

# Who is running this. Your GitHub handle; stamped on every run and ledger row.
OMAR_BENCH_OPERATOR=

# What the agents bill to: subscription | api-key. A run refuses to start without it,
# and enforces it: under `subscription` an API key that is here for a grader is
# never used by an agent.
OMAR_BENCH_AUTH=subscription

# --- Claude Code agents: subscription (`claude setup-token`) or API key ---
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# --- GLM through Claude Code (endpoint goes in bench.toml, token here) ---
# ANTHROPIC_AUTH_TOKEN=

# --- Codex agents: ChatGPT login (`codex login` on this machine writes ~/.codex/auth.json) ---
# or, under OMAR_BENCH_AUTH=api-key, OPENAI_API_KEY below.

# --- Graders: these call a model API and need a real key, whatever the agents use. ---
# The harness does not measure what the graders spend; watch that provider's usage page.
# APEX-Agents. The tasks' default judge runs on Vercel AI Gateway; or name another
# LiteLLM model in GRADING_MODEL and give that provider's key. A non-default judge
# makes scores non-comparable to the leaderboard.
# VERCEL_AI_GATEWAY_API_KEY=
# GRADING_MODEL=
# SWE Atlas. Any OpenAI-compatible endpoint; default model anthropic/claude-opus-4-5-20251101.
# With a codex backend this OPENAI_API_KEY is also what the agents would use.
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# EVAL_MODEL=
