    r48 = Relay(48, 50)
    r49 = Relay(49, 50)
    r50 = Relay(50, 50)
    r1.fwd -> r2.msg
    r2.fwd -> r3.msg
    r3.fwd -> r4.msg
    r4.fwd -> r5.msg
    r5.fwd -> r6.msg
    r6.fwd -> r7.msg
